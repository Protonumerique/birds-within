{
  "name": "birds-within",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Observer-centric, abstract realtime visualisation of the satellite catalogue overhead.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch:catalog": "node scripts/fetch-catalog.mjs && node scripts/pack-catalog.mjs",
    "pack:catalog": "node scripts/pack-catalog.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "make:synthetic": "node scripts/make-synthetic.mjs",
    "validate": "node scripts/validate.mjs",
    "reference": "python3 scripts/reference.py > scripts/reference.json",
    "subset:fonts": "python3 scripts/subset-fonts.py vendor/satoshi",
    "bench": "node scripts/bench.mjs",
    "ucs:military": "python3 scripts/ucs-military.py",
    "voice:probe": "node scripts/voice-probe.mjs"
  },
  "dependencies": {
    "satellite.js": "^7.1.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
